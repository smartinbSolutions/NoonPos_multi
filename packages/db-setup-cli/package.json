{
  "name": "@noonpos/db-setup-cli",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "bundle": "esbuild index.js --bundle --platform=node --format=cjs --outfile=dist/bundle.cjs",
    "build:win": "npm run bundle && pkg dist/bundle.cjs --targets node18-win-x64 --output dist/release/NoonPos-DBSetup.exe"
  },
  "dependencies": {
    "@noonpos/db-setup": "*"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "pkg": "^5.8.1"
  }
}
